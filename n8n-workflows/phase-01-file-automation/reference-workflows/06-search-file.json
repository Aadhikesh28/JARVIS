{
  "name": "06 - JARVIS Search File",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis/search-file",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b2fc033-6c0f-4dee-b88b-f79534639fc0",
      "name": "1. Trigger (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "TRIGGER: Fires on a command like { \"command\": \"find every pdf about taxes\" }.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"gpt-4o-mini\", \"response_format\": {\"type\": \"json_object\"}, \"messages\": [{\"role\": \"system\", \"content\": \"Convert the request into JSON with key: searchTerm (a filename fragment or wildcard pattern, e.g. '*tax*.pdf'). Reply ONLY JSON.\"}, {\"role\": \"user\", \"content\": \"={{$json[\\\"command\\\"]}}\"}]}"
      },
      "id": "21a203b8-4641-47ed-991a-676f2ea50ef3",
      "name": "2. AI Node (Parse Command)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "notes": "AI NODE: Turns a vague description into a concrete search pattern Windows can actually match on.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4f01f934-cf82-455d-85c4-1beb25c3b14c",
              "name": "searchTerm",
              "value": "={{ JSON.parse($json.choices[0].message.content).searchTerm }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "65071ee1-6863-43eb-9d05-32781c6a208d",
      "name": "3. Extract Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        300
      ],
      "notes": "Pulls searchTerm into a usable field.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "30e4bd89-04fb-49f0-9410-14accb5d07f6",
              "leftValue": "={{ $json.searchTerm && $json.searchTerm.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4138118d-6467-4168-b8d1-06ed85785612",
      "name": "4. Condition (Valid Input?)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "notes": "CONDITION: Refuses to continue without something to search for.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Could not determine what to search for from your command.\" } }}",
        "options": {}
      },
      "id": "6400c805-3ce6-435b-ad50-6f46f653b77b",
      "name": "Z. Output (Error - Invalid Input)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        480
      ],
      "notes": "",
      "notesInFlow": true
    },
    {
      "parameters": {
        "command": "=powershell -Command \"Get-ChildItem -Path 'C:\\\\Users\\\\Aadhi\\\\JarvisManaged' -Recurse -Filter '{{$json.searchTerm}}' | Select-Object -ExpandProperty FullName\""
      },
      "id": "06fc2c75-83b0-4db9-b1d8-3a12d8df5143",
      "name": "5. File Node (Execute Command)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1120,
        220
      ],
      "notes": "FILE NODE: Get-ChildItem -Recurse walks every subfolder under the managed root; the result (a list of full paths, one per line) becomes this node's output for the next node to read.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"message\": \"Search complete for: {{$json.searchTerm}}\" } }}",
        "options": {}
      },
      "id": "8ac5c485-69e4-45e1-93c0-49a7f1de38ab",
      "name": "6. Output (Respond to Webhook)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        220
      ],
      "notes": "",
      "notesInFlow": true
    }
  ],
