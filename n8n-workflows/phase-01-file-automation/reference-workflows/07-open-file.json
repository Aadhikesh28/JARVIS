{
  "name": "07 - JARVIS Open File",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis/open-file",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "6a2e6ae7-61df-4a91-97e9-8522e163b660",
      "name": "1. Trigger (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "TRIGGER: Fires on a command like { \"command\": \"open the budget spreadsheet\" }.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"gpt-4o-mini\", \"response_format\": {\"type\": \"json_object\"}, \"messages\": [{\"role\": \"system\", \"content\": \"Convert the request into JSON with key: filePath (relative path incl. filename). Reply ONLY JSON.\"}, {\"role\": \"user\", \"content\": \"={{$json[\\\"command\\\"]}}\"}]}"
      },
      "id": "b6365d1e-2126-48a5-ad46-d580dde800df",
      "name": "2. AI Node (Parse Command)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "notes": "AI NODE: Maps a loose description ('the budget spreadsheet') to a concrete file path.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "8b4add09-2478-49b3-a7b8-bfdd5b8a54e4",
              "name": "filePath",
              "value": "={{ JSON.parse($json.choices[0].message.content).filePath }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7fde5298-6cae-4feb-8d4c-6995e8832445",
      "name": "3. Extract Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        300
      ],
      "notes": "Pulls filePath into a usable field.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4dc2e201-1f31-445b-b1f7-070aab13edfb",
              "leftValue": "={{ $json.filePath && $json.filePath.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3994665f-d26e-4aba-9d4e-f05f380ccdd2",
      "name": "4. Condition (Valid Input?)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "notes": "CONDITION: Refuses to continue without a file to open.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Could not determine which file to open from your command.\" } }}",
        "options": {}
      },
      "id": "683b497a-88c3-4193-8757-c0379469b11c",
      "name": "Z. Output (Error - Invalid Input)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        480
      ],
      "notes": "",
      "notesInFlow": true
    },
    {
      "parameters": {
        "command": "=powershell -Command \"Invoke-Item -Path 'C:\\\\Users\\\\Aadhi\\\\JarvisManaged\\{{$json.filePath}}'\""
      },
      "id": "91df41a2-fcee-4ad4-af6c-af1b0a712a41",
      "name": "5. File Node (Execute Command)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1120,
        220
      ],
      "notes": "FILE NODE: Invoke-Item hands the file to whatever Windows app is registered for its extension \u2014 same as double-clicking it in File Explorer. Runs on the machine hosting n8n.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"message\": \"Opened: {{$json.filePath}}\" } }}",
        "options": {}
      },
      "id": "e172652f-1545-4426-83e2-fe4165d976bc",
      "name": "6. Output (Respond to Webhook)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        220
      ],
      "notes": "",
      "notesInFlow": true
    }
  ],
  "connections": {
